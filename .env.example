# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# Local synthetic mode is the default, including when provider credentials exist.
# These switches are technical controls, not CEO authorization or a privacy approval.
# Do not enable live processing while SECURITY HOLD applies.
RELAY_LIVE_AI_ENABLED=false
RELAY_LIVE_CAPTURE_ENABLED=false

# Explicitly enabled trust signals try this provider first, then the configured fallback.
# Capture uses ONLY this selected provider and requires both live switches above.
LLM_PROVIDER=google

# ElevenLabs
ELEVENLABS_API_KEY=
# Default voice: George (warm British narrator). Browse voices at https://elevenlabs.io/app/voice-library
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Google — pick ONE of the two modes below
# (a) Gemini API key from https://aistudio.google.com
GOOGLE_API_KEY=
# (b) Vertex AI on Google Cloud (uses your Google Cloud credits).
#     Requires `gcloud auth application-default login` or GOOGLE_APPLICATION_CREDENTIALS.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=europe-west1
GOOGLE_MODEL=gemini-2.5-flash
GOOGLE_EMBEDDING_MODEL=gemini-embedding-001

# Relay auth (demo). Generate the secret with: openssl rand -hex 32
SESSION_SECRET=
RELAY_DEMO_PASSCODE=
